// PcTerminal: "Terminal", Linux containers for LineageOS for PCs (distrobox-like, our own code). The app
// keeps its logic in core/ (tested on the host); pc-containerd (containerd/) is the root service.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "PcTerminalCore",
    host_supported: true,
    srcs: ["core/src/**/*.kt"],
    sdk_version: "core_current",
}

java_test_host {
    name: "PcTerminalCoreTests",
    srcs: ["core/tests/**/*.kt"],
    static_libs: [
        "PcTerminalCore",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}

android_app {
    name: "PcTerminal",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "PcTerminalCore",
        "xz-java",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "kotlinx_coroutines_android",
    ],
    optimize: {
        optimize: true,
        shrink_resources: true,
    },
    required: ["pc-containerd"],
}
