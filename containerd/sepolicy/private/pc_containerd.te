# pc-containerd: makes namespaces, mounts and pivots into container root file systems, enters them with
# setns, moves processes between cgroups. The domain is permissive (the whole device is permissive for
# now), so it needs no allow rules yet.
type pc_containerd, domain, coredomain;
type pc_containerd_exec, system_file_type, exec_type, file_type;
type pc_containerd_socket, file_type, coredomain_socket, mlstrustedobject;
type pc_linux_data_file, file_type, data_file_type, core_data_file_type;
type pc_wayland_data_file, file_type, data_file_type, core_data_file_type, mlstrustedobject;
init_daemon_domain(pc_containerd)
permissive pc_containerd;

# The system app (PcTerminal, the compositor) of any user talks to the socket.
unix_socket_connect(system_app, pc_containerd, pc_containerd)

